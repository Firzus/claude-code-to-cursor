{
  "name": "claude-code-to-cursor",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "docker compose up -d && next dev -p 3111",
    "build": "next build",
    "start": "docker compose --profile prod up -d --build",
    "stop": "docker compose --profile prod down",
    "logs": "docker compose --profile prod logs -f app",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "convex:deploy": "convex dev --once"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^3.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.38.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.460.0",
    "next": "16.0.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.8.1",
    "sonner": "^1.7.4",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chrome-remote-interface": "^0.34.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0"
