# =============================================================================
# claude-code-to-cursor — environment variables
#
# Copy to `.env` and fill in the REQUIRED values. Optional values show their
# defaults; uncomment only to override.
# =============================================================================

# --- Cloudflare tunnel ---
# REQUIRED: token from Cloudflare Zero Trust → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Public URL of the tunnel (shown in the dashboard's setup wizard).
CLOUDFLARE_TUNNEL_URL=https://your-tunnel.cfargotunnel.com

# --- Convex (self-hosted) ---
# REQUIRED: 32-byte hex secret. Generate ONCE and keep stable — losing it
# makes the on-disk DB unreadable:
#   openssl rand -hex 32
CONVEX_INSTANCE_SECRET=

# REQUIRED: admin key for the Convex CLI. Generate after Convex is up:
#   docker compose up -d convex
#   docker compose exec convex ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Convex URL — same value works for server-side and browser-side.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# --- Proxy ---
# IP whitelist for the Cloudflare tunnel. Default: Cursor backend IPs.
# Set to "disabled" to allow all IPs (local dev).
# ALLOWED_IPS=52.44.113.131,184.73.225.134

# Shared secret protecting the dashboard settings API (empty = unrestricted).
# SETTINGS_API_KEY=

# --- Logs ---
# LOG_LEVEL=INFO        # VERBOSE | DEBUG | INFO | WARN | ERROR
